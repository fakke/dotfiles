TMUX_PROJECTS_L0="$HOME"
TMUX_PROJECTS_L1="$HOME/.config $HOME/work $HOME/docs $HOME/design $HOME/legal $HOME/code/lab $HOME/code/dev $HOME/code/int $HOME/code/oss"
TMUX_CONNECTIONS_SSH="ec2 nas"
TMUX_SSH_COMMAND='if command -v tmux >/dev/null 2>&1; then if tmux has-session 2>/dev/null; then tmux attach-session; else tmux new-session -A -s main; fi; else exec "$SHELL"; fi'

